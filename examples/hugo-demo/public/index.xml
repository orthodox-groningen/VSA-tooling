      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/voorbeelden/basis/</guid>
      <description>&lt;h1 id=&#34;basisvoorbeelden&#34;&gt;Basisvoorbeelden&lt;/h1&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;a href=&#34;../../&#34;&gt;Home&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;../&#34;&gt;Voorbeelden&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;../multiline/&#34;&gt;Volgende: Multiline&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;voorbeeld-1&#34;&gt;Voorbeeld 1&lt;/h2&gt;&#xA;&lt;h3 id=&#34;invoer&#34;&gt;Invoer&lt;/h3&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-text&#34; data-lang=&#34;text&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;[:] {/Hei_}{/lig_} is de Heer. [\\:]&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id=&#34;svg&#34;&gt;SVG&lt;/h3&gt;&#xA;&#xA;&lt;div class=&#34;vsa-container&#34;&gt;&#xA;  &lt;img&#xA;    class=&#34;vsa-notation&#34;&#xA;    src=&#34;http://localhost:1313/vsa/voorbeelden-basis-block-1.svg&#34;&#xA;    alt=&#34;VSA notatie&#34;&#xA;    loading=&#34;lazy&#34;&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&lt;h3 id=&#34;wat-gebeurt-hier&#34;&gt;Wat gebeurt hier?&lt;/h3&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Onderdeel&lt;/th&gt;&#xA;          &lt;th&gt;Betekenis&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;[:]&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;openings-pitch-marker&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;{/Hei_}&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;scope met modifier&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;is de Heer.&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;gewone tekst&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;[\\:]&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;afsluitende pitch-marker&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;commando&#34;&gt;Commando&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-cmd&#34; data-lang=&#34;cmd&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;vsa svg examples\minimal\valid-demo.vsa output.svg&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;verwachte-output&#34;&gt;Verwachte output&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-text&#34; data-lang=&#34;text&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;SVG geschreven naar: output.svg&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description>
    </item>
