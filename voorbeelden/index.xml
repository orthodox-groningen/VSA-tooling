    <item>
      <title>Basis</title>
      <link>https://orthodox-groningen.github.io/VSA-tooling/voorbeelden/basis/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://orthodox-groningen.github.io/VSA-tooling/voorbeelden/basis/</guid>
      <description>&lt;h1 id=&#34;basis&#34;&gt;Basis&lt;/h1&gt;&#xA;&lt;p&gt;Een klein voorbeeld van VSA-invoer en de SVG-rendering die daaruit ontstaat.&lt;/p&gt;&#xA;&lt;div class=&#34;nav-buttons&#34;&gt;&lt;a class=&#34;btn&#34; href=&#34;../&#34;&gt;&#xD;&#xA;      Voorbeelden&#xD;&#xA;    &lt;/a&gt;&lt;a class=&#34;btn&#34; href=&#34;../multiline/&#34;&gt;&#xD;&#xA;      Volgende: Multiline&#xD;&#xA;    &lt;/a&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;style&gt;&#xD;&#xA;.nav-buttons {&#xD;&#xA;  display: grid;&#xD;&#xA;  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));&#xD;&#xA;  gap: 0.75rem;&#xD;&#xA;  margin: 1rem 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn {&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-direction: column;       &#xD;&#xA;  justify-content: center;      &#xD;&#xA;  align-items: center;          &#xD;&#xA;  text-align: center;&#xD;&#xA;  padding: 0.75rem 0.5rem;      &#xD;&#xA;  background: #eee;&#xD;&#xA;  border-radius: 6px;&#xD;&#xA;  text-decoration: none;&#xD;&#xA;  border: 1px solid #ccc;&#xD;&#xA;  color: #000;&#xD;&#xA;  transition: background 0.2s ease;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn span {&#xD;&#xA;  display: block;&#xD;&#xA;  line-height: 1.25;&#xD;&#xA;  white-space: normal;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn:hover {&#xD;&#xA;  background: #ddd;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&lt;/style&gt;&#xD;&#xA;&#xA;&lt;h2 id=&#34;invoer&#34;&gt;Invoer&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-text&#34; data-lang=&#34;text&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;[:] {/Hei_}{/lig_} is de Heer. [//:]&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;resultaat&#34;&gt;Resultaat&lt;/h2&gt;&#xA;&lt;div class=&#34;vsa-container&#34;&gt;&lt;img class=&#34;vsa-notation&#34; src=&#34;https://orthodox-groningen.github.io/VSA-tooling/vsa/voorbeelden-basis-block-1.svg&#34; alt=&#34;VSA notatie&#34; loading=&#34;lazy&#34;&gt;&lt;/div&gt;&#xA;&#xA;&lt;h2 id=&#34;uitleg&#34;&gt;Uitleg&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Onderdeel&lt;/th&gt;&#xA;          &lt;th&gt;Betekenis&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;[:]&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;openings-pitch-marker&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;{/Hei_}&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;scope met modifier&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;is de Heer.&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;gewone tekst&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;code&gt;[\\:]&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;afsluitende pitch-marker&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;commando&#34;&gt;Commando&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-cmd&#34; data-lang=&#34;cmd&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;vsa svg examples\minimal\valid-demo.vsa output.svg&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;verwachte-output&#34;&gt;Verwachte output&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-text&#34; data-lang=&#34;text&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;SVG geschreven naar: output.svg&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description>
    </item>
    <item>
      <title>Fouten</title>
      <link>https://orthodox-groningen.github.io/VSA-tooling/voorbeelden/fouten/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://orthodox-groningen.github.io/VSA-tooling/voorbeelden/fouten/</guid>
      <description>&lt;h1 id=&#34;fouten&#34;&gt;Fouten&lt;/h1&gt;&#xA;&lt;p&gt;Een voorbeeld van ongeldige VSA-invoer en de foutmelding die de validator teruggeeft.&lt;/p&gt;&#xA;&lt;div class=&#34;nav-buttons&#34;&gt;&lt;a class=&#34;btn&#34; href=&#34;../multiline/&#34;&gt;&#xD;&#xA;      Vorige: Multiline&#xD;&#xA;    &lt;/a&gt;&lt;a class=&#34;btn&#34; href=&#34;../&#34;&gt;&#xD;&#xA;      Voorbeelden&#xD;&#xA;    &lt;/a&gt;&lt;a class=&#34;btn&#34; href=&#34;../markdown/&#34;&gt;&#xD;&#xA;      Volgende: Markdown&#xD;&#xA;    &lt;/a&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;style&gt;&#xD;&#xA;.nav-buttons {&#xD;&#xA;  display: grid;&#xD;&#xA;  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));&#xD;&#xA;  gap: 0.75rem;&#xD;&#xA;  margin: 1rem 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn {&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-direction: column;       &#xD;&#xA;  justify-content: center;      &#xD;&#xA;  align-items: center;          &#xD;&#xA;  text-align: center;&#xD;&#xA;  padding: 0.75rem 0.5rem;      &#xD;&#xA;  background: #eee;&#xD;&#xA;  border-radius: 6px;&#xD;&#xA;  text-decoration: none;&#xD;&#xA;  border: 1px solid #ccc;&#xD;&#xA;  color: #000;&#xD;&#xA;  transition: background 0.2s ease;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn span {&#xD;&#xA;  display: block;&#xD;&#xA;  line-height: 1.25;&#xD;&#xA;  white-space: normal;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn:hover {&#xD;&#xA;  background: #ddd;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&lt;/style&gt;&#xD;&#xA;&#xA;&lt;h2 id=&#34;invoer&#34;&gt;Invoer&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-text&#34; data-lang=&#34;text&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;{/&amp;amp;\tekst_}&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;commando&#34;&gt;Commando&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-cmd&#34; data-lang=&#34;cmd&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;vsa validate examples\expected-fail\semantic-mismatch.vsa&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;voorbeeldfout&#34;&gt;Voorbeeldfout&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-text&#34; data-lang=&#34;text&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;VSA-SEMANTIC-MODIFIER-COUNT-MISMATCH&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;uitleg&#34;&gt;Uitleg&lt;/h2&gt;&#xA;&lt;p&gt;Er zijn meer hoogteposities dan lengteposities.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Markdown en Hugo</title>
      <link>https://orthodox-groningen.github.io/VSA-tooling/voorbeelden/markdown/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://orthodox-groningen.github.io/VSA-tooling/voorbeelden/markdown/</guid>
      <description>&lt;h1 id=&#34;markdown-en-hugo&#34;&gt;Markdown en Hugo&lt;/h1&gt;&#xA;&lt;p&gt;Een voorbeeld van VSA in Markdown en de output die de Hugo-demo gebruikt.&lt;/p&gt;&#xA;&lt;div class=&#34;nav-buttons&#34;&gt;&lt;a class=&#34;btn&#34; href=&#34;../fouten/&#34;&gt;&#xD;&#xA;      Vorige: Fouten&#xD;&#xA;    &lt;/a&gt;&lt;a class=&#34;btn&#34; href=&#34;../&#34;&gt;&#xD;&#xA;      Voorbeelden&#xD;&#xA;    &lt;/a&gt;&lt;a class=&#34;btn&#34; href=&#34;../cli/&#34;&gt;&#xD;&#xA;      Volgende: CLI&#xD;&#xA;    &lt;/a&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;style&gt;&#xD;&#xA;.nav-buttons {&#xD;&#xA;  display: grid;&#xD;&#xA;  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));&#xD;&#xA;  gap: 0.75rem;&#xD;&#xA;  margin: 1rem 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn {&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-direction: column;       &#xD;&#xA;  justify-content: center;      &#xD;&#xA;  align-items: center;          &#xD;&#xA;  text-align: center;&#xD;&#xA;  padding: 0.75rem 0.5rem;      &#xD;&#xA;  background: #eee;&#xD;&#xA;  border-radius: 6px;&#xD;&#xA;  text-decoration: none;&#xD;&#xA;  border: 1px solid #ccc;&#xD;&#xA;  color: #000;&#xD;&#xA;  transition: background 0.2s ease;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn span {&#xD;&#xA;  display: block;&#xD;&#xA;  line-height: 1.25;&#xD;&#xA;  white-space: normal;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn:hover {&#xD;&#xA;  background: #ddd;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&lt;/style&gt;&#xD;&#xA;&#xA;&lt;h2 id=&#34;invoer&#34;&gt;Invoer&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-markdown&#34; data-lang=&#34;markdown&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;::: vsa-notatie&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;[:] {/Hei_}{/lig_} is de Heer. [//:]&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;:::&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;commando&#34;&gt;Commando&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-cmd&#34; data-lang=&#34;cmd&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;vsa build-markdown examples\hugo-demo\content-source generated\content examples\hugo-demo\static\vsa&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;resultaat&#34;&gt;Resultaat&lt;/h2&gt;&#xA;&lt;p&gt;Als de demo-site met shortcode-output wordt gebouwd, komt er in de gegenereerde Markdown ongeveer dit te staan:&lt;/p&gt;</description>
    </item>
    <item>
      <title>Multiline</title>
      <link>https://orthodox-groningen.github.io/VSA-tooling/voorbeelden/multiline/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://orthodox-groningen.github.io/VSA-tooling/voorbeelden/multiline/</guid>
      <description>&lt;h1 id=&#34;multiline&#34;&gt;Multiline&lt;/h1&gt;&#xA;&lt;p&gt;Een voorbeeld waarin een langere VSA-regel automatisch over meerdere regels kan worden gezet.&lt;/p&gt;&#xA;&lt;div class=&#34;nav-buttons&#34;&gt;&lt;a class=&#34;btn&#34; href=&#34;../basis/&#34;&gt;&#xD;&#xA;      Vorige: Basis&#xD;&#xA;    &lt;/a&gt;&lt;a class=&#34;btn&#34; href=&#34;../&#34;&gt;&#xD;&#xA;      Voorbeelden&#xD;&#xA;    &lt;/a&gt;&lt;a class=&#34;btn&#34; href=&#34;../fouten/&#34;&gt;&#xD;&#xA;      Volgende: Fouten&#xD;&#xA;    &lt;/a&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;style&gt;&#xD;&#xA;.nav-buttons {&#xD;&#xA;  display: grid;&#xD;&#xA;  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));&#xD;&#xA;  gap: 0.75rem;&#xD;&#xA;  margin: 1rem 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn {&#xD;&#xA;  display: flex;&#xD;&#xA;  flex-direction: column;       &#xD;&#xA;  justify-content: center;      &#xD;&#xA;  align-items: center;          &#xD;&#xA;  text-align: center;&#xD;&#xA;  padding: 0.75rem 0.5rem;      &#xD;&#xA;  background: #eee;&#xD;&#xA;  border-radius: 6px;&#xD;&#xA;  text-decoration: none;&#xD;&#xA;  border: 1px solid #ccc;&#xD;&#xA;  color: #000;&#xD;&#xA;  transition: background 0.2s ease;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn span {&#xD;&#xA;  display: block;&#xD;&#xA;  line-height: 1.25;&#xD;&#xA;  white-space: normal;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.nav-buttons .btn:hover {&#xD;&#xA;  background: #ddd;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&lt;/style&gt;&#xD;&#xA;&#xA;&lt;h2 id=&#34;invoer&#34;&gt;Invoer&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-text&#34; data-lang=&#34;text&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;[:] {/Hei_}{/lig_} is de Heer en Hij is heilig en wonderbaar in al Zijn werken. [//:]&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;resultaat&#34;&gt;Resultaat&lt;/h2&gt;&#xA;&lt;div class=&#34;vsa-container&#34;&gt;&lt;img class=&#34;vsa-notation&#34; src=&#34;https://orthodox-groningen.github.io/VSA-tooling/vsa/voorbeelden-multiline-block-1.svg&#34; alt=&#34;VSA notatie&#34; loading=&#34;lazy&#34;&gt;&lt;/div&gt;&#xA;&#xA;&lt;h2 id=&#34;commando&#34;&gt;Commando&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-cmd&#34; data-lang=&#34;cmd&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;vsa svg examples\minimal\100_multiline_demo.vsa output.svg --max-line-width 400&#xA;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id=&#34;uitleg&#34;&gt;Uitleg&lt;/h2&gt;&#xA;&lt;p&gt;De renderer breekt regels automatisch af als ze te breed worden.&lt;/p&gt;</description>
    </item>
